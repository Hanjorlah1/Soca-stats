<%- include("./partials/header.ejs") %>
    <div class="container-fluid page-div">
        <%- include("./partials/heading.ejs") %>

        <% if (tName.length === 0) { %>
        <p class="empty-message">No data to show. The server may still be downloading it (wait a minute and refresh), or this season is not available on your API plan.</p>
        <% } %>

        <ul id="team-list">
        <% tName.forEach((team, index) => { %>
        <li class="container-fluid team-name-div team-name">
            <img src="<%= tLogo[index] %>" alt="<%= team %> logo" class="team-logo">
            <span><%= team %></span>
        </li>
    <% }) %>
</ul>

    </div>
<script src="/js/script.js"></script>
</body>
</html>
