 <link rel="stylesheet" href="./styles/stylesheet.css">
</head>

<body>
   <header>
    <nav class="container-fluid">
      <ul>
        <li><a href="">SOCA STATS</a></li>
          <ul class="nav-links">
            <li>home</li>
            <li>leagues</li>
            <li>
             <input type="search">
            </li>
          </ul>
        <li>
          <div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
              <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
            </svg>
          </div>  
        </li>
        <li>
          <div class="bar-div">
            <hr class="bar" />
            <hr class="bar" />
            <hr class="bar" />
          </div>
        </li>
      </ul>
    </nav>
</header>
  <div class="container-fluid ">
    <div class="container-fluid date-bar">
      <div class="date-bar-nav-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-caret-left-fill" viewBox="0 0 16 16">
          <path d="m3.86 8.753 5.482 4.796c.646.566 1.658.106 1.658-.753V3.204a1 1 0 0 0-1.659-.753l-5.48 4.796a1 1 0 0 0 0 1.506z" />
        </svg>
      </div>
      <div>
        <form action="/home/team" method="GET" id="league-form">
          <select name="leagues" id="league">
            <option value="PL">Premier League</option>
            <option value="PD">La Liga</option>
            <option value="BL1">Bundesliga</option>
            <option value="SA">Serie A</option>
            <option value="FL1">Ligue 1</option>
            <option value="CL">UEFA Champions League</option>
            <option value="PPL">Primeira Liga</option>
            <option value="DED">Eredivisie</option>
          </select>
        </form>

        <p class="date-bar-nav-text">2025/2026</p>
      </div>
      <div class="date-bar-nav-btn" >
        <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16">
          <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z" />
        </svg>
      </div>
    </div>
    <div class="container-fluid btn-div">
      <button type="button" class="btn">Teams</button>
      <button type="button" class="btn">Scorers</button>
      <button type="button" class="btn">Table</button>
    </div>
  </div>
