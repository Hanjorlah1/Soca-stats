<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Football Stats</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles/stylesheet.css">
</head>

<body>
  <header>
    <nav class="container-fluid">
      <ul class="nav-ul">
        <li><a href="/home" class="brand-logo">SOCA STATS</a></li>
        <ul class="nav-links nav-ul">
          <li>home</li>
          <li>leagues</li>
          <li>
            <input type="search">
          </li>
        </ul>
        <li>
          <div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
              <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
            </svg>
          </div>
        </li>
        <li>
          <div class="bar-div">
            <hr class="bar" />
            <hr class="bar" />
            <hr class="bar" />
          </div>
        </li>
      </ul>
    </nav>
  </header>
  <div class="container-fluid ">
    <div class="container-fluid date-bar">
      <a <% if (prevYear) { %>href="?leagues=<%= league %>&season=<%= prevYear %>"<% } %> class="date-bar-nav-btn <%= prevYear ? "" : "disabled" %>" title="Previous season">
        <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-caret-left-fill" viewBox="0 0 16 16">
          <path d="m3.86 8.753 5.482 4.796c.646.566 1.658.106 1.658-.753V3.204a1 1 0 0 0-1.659-.753l-5.48 4.796a1 1 0 0 0 0 1.506z" />
        </svg>
      </a>
      <div>
        <form method="GET" id="league-form">
          <% if (seasonYear) { %>
          <input type="hidden" name="season" value="<%= seasonYear %>">
          <% } %>
          <select name="leagues" id="league">
            <% Object.entries(leagueNames).forEach(([code, name]) => { %>
            <option value="<%= code %>" <%= code === league ? "selected" : "" %>><%= name %></option>
            <% }) %>
          </select>
        </form>

        <p class="date-bar-nav-text"><%= season %></p>
      </div>
      <a <% if (nextYear) { %>href="?leagues=<%= league %>&season=<%= nextYear %>"<% } %> class="date-bar-nav-btn <%= nextYear ? "" : "disabled" %>" title="Next season">
        <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16">
          <path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z" />
        </svg>
      </a>
    </div>
    <div class="container-fluid btn-div">
      <% const query = "?leagues=" + league + (seasonYear ? "&season=" + seasonYear : ""); %>
      <a href="/home<%= query %>" class="btn" id="teamBtn">Teams</a>
      <a href="/home/scorer<%= query %>" class="btn" id="scorerBtn">Scorers</a>
      <a href="/home/table<%= query %>" class="btn" id="tableBtn">Table</a>
    </div>
  </div>
